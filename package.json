{
  "name": "kodingu",
  "private": true,
  "version": "1.0.0",
  "description": "Local tooling for the Kodingu static site. The site itself has no build step and ships no runtime dependencies.",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "course-index": "node scripts/make-course-index.mjs",
    "verify": "node scripts/verify.mjs",
    "audit": "node scripts/audit-ui.mjs",
    "icons": "node scripts/fetch-icons.mjs",
    "favicon": "node scripts/make-favicon.mjs",
    "og-image": "node scripts/make-og-image.mjs",
    "sitemap": "node scripts/make-sitemap.mjs"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  },
  "engines": {
    "node": ">=18"
  },
  "type": "module"
}
